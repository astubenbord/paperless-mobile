#!/usr/bin/env bash
# Pre-commit hook for paperless-mobile
# Install via: scripts/install_git_hooks.sh
set -Euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

PASS="${GREEN}[PASS]${NC}"
FAIL="${RED}[FAIL]${NC}"
WARN="${YELLOW}[WARN]${NC}"

ERRORS=0

# Collect staged .dart files (excluding generated files)
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' | grep -v '\.g\.dart$' | grep -v '\.freezed\.dart$' || true)

echo "Running pre-commit checks..."

# Check merge conflict markers
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)
if [ -n "$STAGED_FILES" ]; then
  CONFLICT_FILES=$(echo "$STAGED_FILES" | xargs grep -lE '^(<<<<<<<|=======|>>>>>>>)' 2>/dev/null || true)
  if [ -n "$CONFLICT_FILES" ]; then
    echo -e "${FAIL} Merge conflict markers found in:"
    echo "$CONFLICT_FILES" | sed 's/^/  /'
    ERRORS=$((ERRORS + 1))
  else
    echo -e "${PASS} No merge conflict markers"
  fi
fi

# Calculate set of staged dart files
if [ -n "$STAGED_DART_FILES" ]; then
  echo "Checking Dart formatting..."
  UNFORMATTED=$(echo "$STAGED_DART_FILES" | xargs fvm dart format --output=none --set-exit-if-changed 2>&1 || true)
  if echo "$UNFORMATTED" | grep -q 'Changed'; then
    echo -e "${FAIL} Dart formatting issues — run: fvm dart format ."
    echo "$UNFORMATTED" | grep 'Changed' | sed 's/^/  /'
    ERRORS=$((ERRORS + 1))
  else
    echo -e "${PASS} Dart formatting"
  fi
else
  echo -e "${PASS} Dart formatting (no staged Dart files)"
fi

# Run analyzer
if [ -n "$STAGED_DART_FILES" ]; then
  echo "Running dart analyze on staged files..."
  ANALYZE_OUTPUT=$(echo "$STAGED_DART_FILES" | xargs fvm dart analyze --no-fatal-infos 2>&1)
  ANALYZE_EXIT=$?
  if [ $ANALYZE_EXIT -ne 0 ]; then
    echo -e "${FAIL} Dart analyzer reported issues:"
    echo "$ANALYZE_OUTPUT" | tail -n 40 | sed 's/^/  /'
    ERRORS=$((ERRORS + 1))
  else
    echo -e "${PASS} Dart analyzer"
  fi
else
  echo -e "${PASS} Dart analyzer (no staged Dart files)"
fi

echo ""
if [ $ERRORS -gt 0 ]; then
  echo -e "${RED}Pre-commit hook failed with $ERRORS error(s). Fix the issues above or use git commit --no-verify to skip.${NC}"
  exit 1
fi

echo -e "${GREEN}All pre-commit checks passed.${NC}"
exit 0
